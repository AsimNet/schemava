# Keep the customer's `composer require` archive lean: development, build,
# test, and editor/AI files are export-ignored, so the published package
# contains only runtime code (src, config, database, compiled assets in
# resources/dist, views, lang) plus composer.json, LICENSE and README.
# git archive / the GitHub tarballs Packistry serves honor these rules.
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/tests              export-ignore
/resources/js       export-ignore
/package.json       export-ignore
/package-lock.json  export-ignore
/vite.config.js     export-ignore
/vitest.config.js   export-ignore
/phpunit.xml        export-ignore
/README.ar.md       export-ignore
/CLAUDE.md          export-ignore
/AGENTS.md          export-ignore
/.claude            export-ignore
/.cursor            export-ignore
/.cursorrules       export-ignore
/.idea              export-ignore
