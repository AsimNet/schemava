{
    "name": "asimnet/schemava",
    "description": "Visual multilingual form builder built specifically for FilamentPHP panels with SurveyJS-compatible JSON export.",
    "keywords": [
        "laravel",
        "filament",
        "filamentphp",
        "form-builder",
        "forms",
        "i18n",
        "multilingual",
        "rtl",
        "multi-tenant",
        "surveyjs-compatible"
    ],
    "homepage": "https://github.com/AsimNet/schemava",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Asimnet",
            "email": "dev@asimnet.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^11.0|^12.0",
        "spatie/laravel-package-tools": "^1.15"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/ai": "^0.8.1",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "laravel/ai": "Required for the bundled AI assistant adapter (LaravelAiAssistant). Install ^0.8 and configure a provider key to enable AI-assisted form building."
    },
    "autoload": {
        "psr-4": {
            "AsimNet\\Schemava\\": "src/",
            "AsimNet\\Schemava\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AsimNet\\Schemava\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AsimNet\\Schemava\\SchemavaServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "@php vendor/bin/pint --ansi",
            "@php vendor/bin/phpstan analyse --verbose --ansi"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
