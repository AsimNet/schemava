{
    "name": "asimnet/schemava",
    "description": "Visual multilingual form builder built specifically for FilamentPHP panels with SurveyJS-compatible JSON export.",
    "keywords": [
        "laravel",
        "filament",
        "filamentphp",
        "form-builder",
        "forms",
        "i18n",
        "multilingual",
        "rtl",
        "multi-tenant",
        "surveyjs-compatible"
    ],
    "homepage": "https://github.com/AsimNet/schemava",
    "license": "proprietary",
    "type": "library",
    "authors": [
        {
            "name": "Asimnet",
            "email": "dev@asimnet.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^11.0|^12.0",
        "spatie/laravel-package-tools": "^1.15"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "laravel/ai": "Required only for the bundled AI assistant adapter (LaravelAiOpenRouterAssistant). Install ^0.1.5 to enable AI-assisted form building."
    },
    "autoload": {
        "psr-4": {
            "AsimNet\\Schemava\\": "src/",
            "AsimNet\\Schemava\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AsimNet\\Schemava\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AsimNet\\Schemava\\SchemavaServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
